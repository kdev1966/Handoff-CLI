#!/bin/bash
PROJECT_PATH=$(pwd)
PROJECT_NAME=$(basename "$PROJECT_PATH")
DB_PATH="$HOME/.mcp_memory/global_projects.db"

# Ignorer si la mémoire globale est mise en pause par l'utilisateur
if [ "$MCP_DISABLE" = "true" ]; then
    exit 0
fi

# Ne s'exécuter que dans des répertoires de développement (présence de marqueurs communs)
if [ ! -d .git ] && [ ! -f package.json ] && [ ! -f requirements.txt ] && [ ! -f pyproject.toml ] && [ ! -f Cargo.toml ]; then
    exit 0
fi

# Créer le répertoire de la BDD si premier lancement
mkdir -p "$(dirname "$DB_PATH")"

# Initialiser la table si elle n'existe pas encore
sqlite3 "$DB_PATH" <<EOF
CREATE TABLE IF NOT EXISTS project_memory (
    project_path TEXT PRIMARY KEY,
    project_name TEXT,
    tech_stack TEXT,
    last_state_summary TEXT,
    next_actions TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
EOF

# Récupérer les données du projet actuel
DATA=$(sqlite3 "$DB_PATH" "SELECT tech_stack, last_state_summary, next_actions FROM project_memory WHERE project_path='$PROJECT_PATH';")

if [ -z "$DATA" ]; then
    STACK="À détecter par l'IA"
    SUMMARY="Nouveau projet détecté par le système de mémoire globale."
    ACTIONS="Définir le premier objectif technique."
else
    # Séparation sécurisée des colonnes retournées par SQLite (séparateur '|')
    IFS='|' read -r STACK SUMMARY ACTIONS <<< "$DATA"
fi

# Génération dynamique du fichier de contexte universel pour tous vos IDEs et outils IA
cat <<EOM > .ai_context.md
# 🧠 PROTOCOLE DE MÉMOIRE IA UNIVERSEL
> **CONSIGNE GLOBALE POUR LES AGENTS IA (Claude, Copilot, Gemini, Codex) :**
> Ce projet utilise un système de mémoire partagée. Prenez impérativement connaissance de ce fichier avant d'écrire ou de modifier du code.
> Avant de clore la session de chat ou d'interrompre votre exécution, vous devez obligatoirement mettre à jour cette mémoire (via l'outil MCP ou en modifiant ce fichier) pour guider le prochain agent.

## 📁 Métadonnées du Projet
* **Nom :** $PROJECT_NAME
* **Chemin absolu :** $PROJECT_PATH

## 🛠️ Stack Technique & Architecture
$STACK

## 📝 Dernier État Stable & Contexte Récent
$SUMMARY

## 🎯 Prochaines Actions Immédiates
$ACTIONS
EOM
